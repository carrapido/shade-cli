#!/usr/bin/env python3
"""
shade-cli: Lector interactivo de manga estilo ani-cli para terminal.
Descarga y abre capítulos como PDF en tu visor favorito sin anuncios.
Compatible con macOS y distribuciones Linux (Arch Linux, Debian, Fedora, etc.).
"""

import sys
import os
import re
import json
import math
import ssl
import functools
import shutil
import tempfile
import unicodedata
import zipfile
import subprocess
import urllib.request
import urllib.parse
from pathlib import Path
from collections.abc import Sequence
from typing import NamedTuple, Optional
from difflib import SequenceMatcher, get_close_matches
from concurrent.futures import ThreadPoolExecutor

# --- Constants & Configuration ---

VERSION = "1.1.0"
API_BASE = "https://shademanga.com/api"
CONFIG_DIR = Path.home() / ".config" / "shade-cli"
CACHE_DIR = Path.home() / ".cache" / "shade-cli"
DOWNLOAD_DIR_ENV = "SHADE_DOWNLOAD_DIR"
DEFAULT_DOWNLOAD_DIR = Path.home() / "Downloads" / "shade-cli"
HISTORY_FILE = CONFIG_DIR / "history.json"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# ANSI Colors
CLR_RESET = "\033[0m"
CLR_BOLD = "\033[1m"
CLR_DIM = "\033[2m"
CLR_GREEN = "\033[32m"
CLR_YELLOW = "\033[33m"
CLR_BLUE = "\033[34m"
CLR_CYAN = "\033[36m"

# fzf exits with 130 on Esc. Ctrl-C is declared with --expect, so fzf prints it as a key
# instead of also exiting with 130, and the app can tell "go back" from "quit".
FZF_ESC_STATUS = 130
FZF_QUIT_KEY = "ctrl-c"
FZF_KEYS_HINT = "Enter: elegir · Esc: regresar · Ctrl-C: salir"

# Typo-tolerant search (see the section of the same name).
MIN_SIMILARITY = 0.75  # Calibrated on live searches: intended titles scored >= 0.82, unrelated ones <= 0.69.
MAX_SEARCH_PROBES = 8  # The API answers HTTP 429 when flooded.
PARALLEL_PROBES = 4
MIN_PROBE_LENGTH = 3  # Shorter pieces match thousands of titles and push the right one off the first page.

# Picker values that are actions instead of a manga or a chapter.
QUIT = object()
SAVE_PDF = object()
ADULT_CATEGORY = object()

ADULT_PROMPT = "+18 NSFW > "

# Search tags: words in the search bar that start with "-".
ADULT_TAGS = {"nsfw", "18", "+18"}
SEARCH_TAGS_HINT = "Etiquetas: -nsfw solo +18 · -<género> filtra (naruto -accion) · géneros: shade-cli --generos"


# --- Main Entry Point ---

def main():
    """Main CLI entry point."""
    args = parse_arguments()

    if args.version:
        print(f"shade-cli v{VERSION}")
        return
    if args.genres:
        print_genre_tags()
        return

    print_banner()
    if args.continue_reading:
        continue_last_reading(download_mode=args.download, terminal_mode=args.terminal)

    query = " ".join(args.query).strip()
    browse_from_search(query, download_mode=args.download, terminal_mode=args.terminal)


# --- Screens ---
# Screens stack up: search prompt → search results → chapter list → reader menu.
# Each screen loops over its own picker; a picker returns None on Esc, which ends
# that loop and hands control back to the previous screen.

def continue_last_reading(download_mode: bool = False, terminal_mode: bool = False):
    """Opens the chapter list of the last manga read, starting at the last chapter."""
    history = load_history()
    last_manga = history.get("last_manga")
    if not last_manga:
        print_warn("Todavía no hay historial: empieza con una búsqueda.")
        return

    print_info(f"Continuando: {CLR_BOLD}{last_manga.get('titulo')}{CLR_RESET}")
    browse_chapters(
        last_manga,
        initial_chapter_id=history.get("last_chapter_id"),
        download_mode=download_mode,
        terminal_mode=terminal_mode
    )


def browse_from_search(initial_query: str, download_mode: bool = False, terminal_mode: bool = False):
    """Search prompt screen. Esc here exits the app."""
    query = initial_query or ask_search_query()
    while query:
        browse_search_results(query, download_mode=download_mode, terminal_mode=terminal_mode)
        query = ask_search_query()


def browse_search_results(raw_query: str, download_mode: bool = False, terminal_mode: bool = False):
    """Search results screen. Tags in the query: -nsfw opens the +18 list directly, -<género> filters by genre.
    Esc returns to the search prompt."""
    query = parse_search_query(raw_query)
    mangas = run_search(query, raw_query)
    if not mangas:
        return

    general, adult = split_by_age_rating(mangas)
    if query.adult_only:
        browse_adult_only(adult, raw_query, download_mode=download_mode, terminal_mode=terminal_mode)
    else:
        browse_general_results(general, adult, download_mode=download_mode, terminal_mode=terminal_mode)


def run_search(query: "SearchQuery", raw_query: str) -> list:
    """Resolves the genre tags and searches. Warns and returns [] when a tag is unknown or nothing matches."""
    genres = resolve_genres(query.genre_tags)
    if genres is None:
        return []
    print_info(f"Buscando '{raw_query}'...")
    mangas = search_series(query.text, genres)
    if not mangas:
        print_warn(f"No se encontraron resultados para: '{raw_query}'")
    return mangas


def browse_adult_only(adult: list, raw_query: str, download_mode: bool = False, terminal_mode: bool = False):
    """-nsfw: straight to the +18 list. Esc returns to the search prompt."""
    if not adult:
        print_warn(f"No hay resultados +18 NSFW para '{raw_query}'.")
        return
    browse_adult_results(adult, download_mode=download_mode, terminal_mode=terminal_mode)


def browse_general_results(general: list, adult: list, download_mode: bool = False, terminal_mode: bool = False):
    """General titles, with the +18 ones behind their own entry at the end. Esc returns to the search prompt."""
    if adult:
        print_info(f"{results_count(len(adult))} +18 NSFW quedaron aparte: elige «+18 NSFW» al final de la lista o busca con -nsfw.")
    choice = pick_manga(general, adult_count=len(adult))
    while choice:
        if choice is ADULT_CATEGORY:
            browse_adult_results(adult, download_mode=download_mode, terminal_mode=terminal_mode)
        else:
            browse_chapters(choice, download_mode=download_mode, terminal_mode=terminal_mode)
        choice = pick_manga(general, adult_count=len(adult))


def split_by_age_rating(mangas: list) -> tuple:
    """(general, adult). Adult titles are the ones the API flags with esMayorDeEdad; unflagged ones count as general."""
    general = [m for m in mangas if not m.get("esMayorDeEdad")]
    adult = [m for m in mangas if m.get("esMayorDeEdad")]
    return general, adult


def results_count(count: int) -> str:
    return f"{count} resultado" if count == 1 else f"{count} resultados"


def browse_adult_results(mangas: list, download_mode: bool = False, terminal_mode: bool = False):
    """+18 NSFW results screen. Esc returns to the general search results."""
    manga = pick_manga(mangas, prompt=ADULT_PROMPT)
    while manga:
        browse_chapters(manga, download_mode=download_mode, terminal_mode=terminal_mode)
        manga = pick_manga(mangas, prompt=ADULT_PROMPT)


def browse_chapters(manga: dict, initial_chapter_id: Optional[str] = None, download_mode: bool = False, terminal_mode: bool = False):
    """Chapter list screen. Esc returns to the search results."""
    title = manga.get("titulo", "Manga")
    print_info(f"Cargando capítulos de '{title}'...")
    chapters = fetch_chapters(manga.get("publicId"))
    if not chapters:
        print_warn("Esta serie no tiene capítulos disponibles.")
        return

    chapter = find_chapter(chapters, initial_chapter_id) or pick_chapter(chapters, manga_title=title)
    while chapter:
        if download_mode:
            download_chapter(chapter, manga_title=title)
        else:
            read_from(chapter, chapters, manga, terminal_mode=terminal_mode)
        chapter = pick_chapter(chapters, manga_title=title)


def find_chapter(chapters: list, chapter_id: Optional[str]):
    """Returns the chapter with that publicId, or None."""
    if not chapter_id:
        return None
    return next((c for c in chapters if c.get("publicId") == chapter_id), None)


def read_from(chapter: dict, chapters: list, manga: dict, terminal_mode: bool = False):
    """Reader screen: opens a chapter, then asks what comes next. Esc returns to the chapter list."""
    title = manga.get("titulo", "Manga")
    while chapter:
        save_history(manga, chapter)
        open_chapter(chapter, manga_title=title, terminal_mode=terminal_mode)
        chapter = pick_next_step(chapter, chapters, manga_title=title)


def open_chapter(chapter: dict, manga_title: str, terminal_mode: bool = False):
    """Opens a chapter as a PDF in the system viewer, or page by page in the terminal."""
    if terminal_mode:
        read_in_terminal_mode(chapter, manga_title=manga_title)
    else:
        read_in_pdf_mode(chapter, manga_title=manga_title)


def pick_next_step(chapter: dict, chapters: list, manga_title: str):
    """Reader menu. Returns the chapter to open next, or None to go back to the chapter list."""
    while True:
        choice = choose(reader_menu_options(chapter, chapters), prompt="¿Qué sigue? > ")
        if choice is QUIT:
            exit_app()
        if choice is not SAVE_PDF:
            return choice
        save_chapter_pdf(chapter, manga_title)


def reader_menu_options(chapter: dict, chapters: list) -> list:
    """(value, label) pairs for the reader menu; neighbours appear only when they exist."""
    position = chapters.index(chapter)
    following = chapters[position + 1] if position + 1 < len(chapters) else None
    previous = chapters[position - 1] if position > 0 else None

    options = []
    if following:
        options.append((following, f"Siguiente  → Cap. {following.get('numeroCapitulo')}"))
    options.append((chapter, f"Reabrir    ↺ Cap. {chapter.get('numeroCapitulo')}"))
    if previous:
        options.append((previous, f"Anterior   ← Cap. {previous.get('numeroCapitulo')}"))
    options.append((SAVE_PDF, "Guardar PDF en carpeta…"))
    options.append((None, "Elegir otro capítulo"))
    options.append((QUIT, "Salir"))
    return options


# --- Search tags ---
# "naruto -accion -nsfw": words starting with "-" are tags. -nsfw keeps only +18 titles (the API has
# no adult filter, so it is applied locally); any other tag is a genre, sent to the API's `genero` filter.

class SearchQuery(NamedTuple):
    text: str
    genre_tags: list
    adult_only: bool


def parse_search_query(raw_query: str) -> SearchQuery:
    """Splits the search bar text into title words and tags. Hyphens inside a genre tag stand for spaces."""
    words, genre_tags, adult_only = [], [], False
    for word in raw_query.split():
        tag = word[1:].lower()
        if not (word.startswith("-") and tag):
            words.append(word)
        elif tag in ADULT_TAGS:
            adult_only = True
        else:
            genre_tags.append(tag.replace("-", " "))
    return SearchQuery(" ".join(words), genre_tags, adult_only)


def resolve_genres(tags: list) -> Optional[list]:
    """Catalog names for the genre tags, or None after warning about the first unknown one."""
    if not tags:
        return []
    names_by_key = genre_names_by_key()
    unknown = [tag for tag in tags if normalize_title(tag) not in names_by_key]
    if unknown:
        warn_unknown_genre(unknown[0], names_by_key)
        return None
    return [names_by_key[normalize_title(tag)] for tag in tags]


def genre_names_by_key() -> dict:
    """Genre names keyed by their accent- and punctuation-free form; on a collision the genre with more series wins."""
    by_key = {}
    for genre in sorted(fetch_genres(), key=lambda g: g.get("total", 0)):
        by_key[normalize_title(genre["nombre"])] = genre["nombre"]
    return by_key


def warn_unknown_genre(tag: str, names_by_key: dict):
    close = get_close_matches(normalize_title(tag), names_by_key, n=3, cutoff=0.6)
    suggestion = f" ¿Quisiste decir: {', '.join(genre_tag(names_by_key[key]) for key in close)}?" if close else ""
    print_warn(f"No existe el género '{tag}'.{suggestion} Ve la lista con: shade-cli --generos")


def genre_tag(genre_name: str) -> str:
    """The tag to type for a genre: 'Boys Love' → '-boys-love', 'Acción' → '-accion'."""
    return "-" + normalize_title(genre_name).replace(" ", "-")


def print_genre_tags():
    """--generos: every genre as the tag to type, most series first, one line per tag."""
    printed = set()
    for genre in sorted(fetch_genres(), key=lambda g: g.get("total", 0), reverse=True):
        tag = genre_tag(genre["nombre"])
        if tag not in printed:
            printed.add(tag)
            print(f"{tag:<30} {genre['nombre']} ({genre.get('total', 0)})")


# --- Typo-tolerant search ---
# The API only matches substrings ("berse" finds Berserk, "berzerk" finds nothing) and pages its
# ~48,700 series 30 at a time, so the catalog cannot be searched locally. When the exact search
# finds nothing, the app asks for pieces of the query that survive a typo and ranks what comes
# back by similarity to what the user typed.

def search_series(query: str, genres: Sequence[str] = ()) -> list:
    """Exact search first; when it finds nothing, the typo-tolerant search. Genres filter both."""
    exact = fetch_search_results(query, genres)
    if exact or not query:
        return exact
    print_info(f"Sin coincidencias exactas para '{query}'; buscando títulos parecidos...")
    return find_similar_series(query, genres)


def find_similar_series(query: str, genres: Sequence[str] = ()) -> list:
    """Searches pieces of the query that survive a typo and keeps the titles most similar to it."""
    batches = fetch_probe_results(search_probes(query), genres)
    if batches and all(batch is None for batch in batches):
        print_warn("El servidor no respondió a la búsqueda aproximada; intenta de nuevo en unos segundos.")
        return []
    return rank_by_similarity(query, unique_series(batches))


def search_probes(query: str) -> list:
    """Pieces of the query the API can still match despite a typo, most specific first, without duplicates."""
    words = normalize_title(query).split()
    probes = phrase_probes(words) + word_edge_probes(words) + swapped_letter_probes(words)
    long_enough = [probe for probe in dict.fromkeys(probes) if len(probe) >= MIN_PROBE_LENGTH]
    return long_enough[:MAX_SEARCH_PROBES]


def phrase_probes(words: list) -> list:
    """The phrase without its last word and without its first: 'boku no hero academy' → 'boku no hero'."""
    if len(words) < 2:
        return []
    return [" ".join(words[:-1]), " ".join(words[1:])]


def word_edge_probes(words: list) -> list:
    """Start and end of each word. A typo breaks every piece that contains it; in longer words
    the two pieces never share a letter, so one of them stays intact ('berzerk' → 'ber', 'erk')."""
    probes = []
    for word in words:
        if len(word) >= MIN_PROBE_LENGTH:
            size = max(MIN_PROBE_LENGTH, (len(word) - 1) // 2)
            probes += [word[:size], word[-size:]]
    return probes


def swapped_letter_probes(words: list) -> list:
    """For a single word, the word with each pair of neighbouring letters swapped: 'naurto' → 'naruto'."""
    if len(words) != 1:
        return []
    word = words[0]
    return [word[:i] + word[i + 1] + word[i] + word[i + 2:] for i in range(len(word) - 1)]


def fetch_probe_results(probes: list, genres: Sequence[str] = ()) -> list:
    """Search results per probe, PARALLEL_PROBES at a time; None for a probe whose request failed."""
    search = functools.partial(try_fetch_search_results, genres=genres)
    with ThreadPoolExecutor(max_workers=PARALLEL_PROBES) as executor:
        return list(executor.map(search, probes))


def unique_series(batches: list) -> list:
    by_id = {}
    for batch in batches:
        for manga in batch or []:
            by_id.setdefault(manga.get("publicId"), manga)
    return list(by_id.values())


def rank_by_similarity(query: str, mangas: list) -> list:
    """Titles scoring at least MIN_SIMILARITY, best first."""
    scored = [(similarity_score(query, manga.get("titulo", "")), manga) for manga in mangas]
    scored.sort(key=lambda pair: pair[0], reverse=True)
    return [manga for (best_slice, _), manga in scored if best_slice >= MIN_SIMILARITY]


def similarity_score(query: str, title: str) -> tuple:
    """(match against the closest slice of the title as long as the query, match against the whole title),
    each from 0 to 1. The first lets 'punpn' find 'Oyasumi Punpun'; the second breaks ties toward the
    title closest to the whole query ('bleack' ranks 'Bleach' before 'Black Box')."""
    q, t = normalize_title(query), normalize_title(title)
    whole = SequenceMatcher(None, q, t).ratio()
    if len(t) <= len(q):
        return whole, whole
    best_slice = max(SequenceMatcher(None, q, t[i:i + len(q)]).ratio() for i in range(len(t) - len(q) + 1))
    return best_slice, whole


def normalize_title(text: str) -> str:
    """Lowercase, without accents or punctuation: 'Pokémon: Adventures!' → 'pokemon adventures'."""
    decomposed = unicodedata.normalize("NFKD", text.lower())
    without_accents = "".join(c for c in decomposed if not unicodedata.combining(c))
    return " ".join(re.sub(r"[\W_]+", " ", without_accents).split())


# --- Reading Engines ---

def read_in_pdf_mode(chapter: dict, manga_title: str):
    """Opens the chapter PDF in the system viewer (Preview on macOS, zathura/xdg-open on Linux)."""
    pdf_path = ensure_chapter_pdf(chapter, manga_title)
    if not pdf_path:
        return

    print_success(f"Abriendo Cap. {chapter.get('numeroCapitulo', '?')} en tu visor de PDF.")
    print_info(f"PDF en caché: {pdf_path}")
    print_info("Para conservar una copia, elige «Guardar PDF en carpeta…» en el menú.")
    open_file_in_system_viewer(pdf_path)


def ensure_chapter_pdf(chapter: dict, manga_title: str) -> Optional[Path]:
    """Returns the chapter PDF from the cache, downloading and compiling it on a cache miss."""
    pdf_path = CACHE_DIR / chapter_file_name(manga_title, chapter, "pdf")
    if pdf_path.exists():
        return pdf_path

    chap_num = chapter.get("numeroCapitulo", "?")
    pages = fetch_chapter_pages(chapter.get("publicId"))
    if not pages:
        print_warn(f"No se pudieron obtener las páginas del Cap. {chap_num}.")
        return None

    print_info(f"Descargando {len(pages)} páginas de {manga_title} (Cap. {chap_num})...")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="shade_pdf_") as tmp_dir:
        downloaded_files = download_pages_parallel(pages, Path(tmp_dir))
        if not downloaded_files:
            print_warn("Error al descargar páginas.")
            return None

        print_info("Generando PDF del capítulo...")
        if not compile_images_to_pdf(downloaded_files, pdf_path):
            print_warn("No se pudo compilar el PDF. Verifica tener instalado 'graphicsmagick' o 'imagemagick'.")
            return None
    return pdf_path


def read_in_terminal_mode(chapter: dict, manga_title: str):
    """Fallback reader directly in terminal blocks with timg."""
    chap_id = chapter.get("publicId")
    chap_num = chapter.get("numeroCapitulo", "?")
    pages = fetch_chapter_pages(chap_id)
    if not pages:
        return

    total = len(pages)
    with tempfile.TemporaryDirectory(prefix="shade_term_") as tmp_dir:
        tmp_path = Path(tmp_dir)
        downloaded = download_pages_parallel(pages, tmp_path)

        for idx, img_path in enumerate(downloaded):
            clear_screen()
            print(f"{CLR_BOLD}{manga_title}{CLR_RESET} ─ Cap. {chap_num} [{idx + 1}/{total}]")
            render_image_timg(img_path)
            try:
                cmd = input(f"\n[Pág {idx + 1}/{total}] (Enter: Siguiente, q: Salir): ").strip().lower()
                if cmd == "q":
                    break
            except (KeyboardInterrupt, EOFError):
                break


# --- Saving ---

def save_chapter_pdf(chapter: dict, manga_title: str):
    """Copies the chapter PDF from the cache to a folder the user picks. Esc cancels."""
    pdf_path = ensure_chapter_pdf(chapter, manga_title)
    if not pdf_path:
        return

    answer = ask_text("Guardar en carpeta > ", default=str(download_dir_for(manga_title)))
    if not answer:
        return
    copy_to_folder(pdf_path, Path(answer).expanduser().absolute())


def copy_to_folder(file_path: Path, folder: Path):
    try:
        folder.mkdir(parents=True, exist_ok=True)
        saved = shutil.copy2(file_path, folder)
    except OSError as error:
        print_warn(f"No se pudo guardar en {folder}: {error.strerror or error}")
        return
    print_success(f"PDF guardado en: {saved}")


def download_dir_for(manga_title: str) -> Path:
    """$SHADE_DOWNLOAD_DIR/<manga>, or ~/Downloads/shade-cli/<manga> when the variable is unset."""
    base = os.environ.get(DOWNLOAD_DIR_ENV)
    base_dir = Path(base).expanduser() if base else DEFAULT_DOWNLOAD_DIR
    return base_dir / sanitize_filename(manga_title)


# --- PDF Compilation & Downloader ---

def compile_images_to_pdf(image_files: list, output_pdf: Path) -> bool:
    """
    Compiles image paths into a single PDF.
    Supports GraphicsMagick (gm), ImageMagick 7 (magick), ImageMagick 6 (convert),
    img2pdf, and macOS sips+poppler.
    """
    # 1. Try GraphicsMagick (gm)
    gm_bin = shutil.which("gm") or (os.path.exists("/opt/homebrew/bin/gm") and "/opt/homebrew/bin/gm")
    if gm_bin:
        cmd = [gm_bin, "convert", "-compress", "JPEG"] + [str(f) for f in image_files] + [str(output_pdf)]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and output_pdf.exists():
            return True

    # 2. Try ImageMagick 7 (magick) - default on modern Arch Linux
    magick_bin = shutil.which("magick")
    if magick_bin:
        cmd = [magick_bin] + [str(f) for f in image_files] + [str(output_pdf)]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and output_pdf.exists():
            return True

    # 3. Try ImageMagick legacy (convert)
    convert_bin = shutil.which("convert")
    if convert_bin:
        cmd = [convert_bin] + [str(f) for f in image_files] + [str(output_pdf)]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and output_pdf.exists():
            return True

    # 4. Try img2pdf (python-img2pdf on Arch Linux)
    img2pdf_bin = shutil.which("img2pdf")
    if img2pdf_bin:
        cmd = [img2pdf_bin, "-o", str(output_pdf)] + [str(f) for f in image_files]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and output_pdf.exists():
            return True

    # 5. Fallback on macOS: sips + pdfunite
    pdfunite = shutil.which("pdfunite") or (os.path.exists("/opt/homebrew/bin/pdfunite") and "/opt/homebrew/bin/pdfunite")
    sips = shutil.which("sips") or "/usr/bin/sips"
    if pdfunite and sips and os.path.exists(sips):
        with tempfile.TemporaryDirectory(prefix="sips_pdf_") as stmp:
            stmp_path = Path(stmp)
            single_pdfs = []
            for idx, img in enumerate(image_files):
                spdf = stmp_path / f"p_{idx:03d}.pdf"
                subprocess.run([sips, "-s", "format", "pdf", str(img), "--out", str(spdf)], capture_output=True)
                if spdf.exists():
                    single_pdfs.append(str(spdf))

            if single_pdfs:
                subprocess.run([pdfunite] + single_pdfs + [str(output_pdf)], capture_output=True)
                return output_pdf.exists()

    return False


def download_pages_parallel(pages: list, dest_dir: Path) -> list:
    """Downloads pages concurrently using a thread pool."""
    def _download_single(item):
        idx, url = item
        ext = url.split("?")[0].split(".")[-1] or "webp"
        file_path = dest_dir / f"p_{idx:03d}.{ext}"
        download_binary_file(url, file_path)
        return idx, file_path

    items = list(enumerate(pages, 1))
    results = []
    with ThreadPoolExecutor(max_workers=8) as executor:
        for idx, path in executor.map(_download_single, items):
            results.append((idx, path))

    results.sort(key=lambda x: x[0])
    return [path for _, path in results]


def download_chapter(chapter: dict, manga_title: str):
    """Downloads all pages into a .cbz comic archive in the download folder."""
    pages = fetch_chapter_pages(chapter.get("publicId"))
    if not pages:
        print_warn("No hay páginas para descargar.")
        return

    out_dir = download_dir_for(manga_title)
    out_dir.mkdir(parents=True, exist_ok=True)
    cbz_path = out_dir / chapter_file_name(manga_title, chapter, "cbz")
    print_info(f"Descargando {len(pages)} páginas en: {out_dir}")

    with tempfile.TemporaryDirectory(prefix="shade_dl_") as tmp_dir:
        downloaded = download_pages_parallel(pages, Path(tmp_dir))

        print_info("Empaquetando en archivo CBZ...")
        with zipfile.ZipFile(cbz_path, "w", zipfile.ZIP_DEFLATED) as zipf:
            for f in sorted(downloaded):
                zipf.write(f, arcname=f.name)

    print_success(f"Guardado en: {cbz_path}")


# --- Interactive Pickers (FZF & Fallbacks) ---

def pick_manga(mangas: list, prompt: str = "Selecciona manga > ", adult_count: int = 0):
    """Search results picker. Returns the manga, ADULT_CATEGORY, or None on Esc."""
    options = [(m, manga_label(m)) for m in mangas]
    if adult_count:
        options.append((ADULT_CATEGORY, adult_category_label(adult_count)))
    return choose(options, prompt=prompt)


def pick_chapter(chapters: list, manga_title: str):
    """Chapter list picker. Returns the chapter, or None on Esc."""
    options = [(c, chapter_label(c)) for c in chapters]
    return choose(options, prompt=f"{manga_title} > ")


def manga_label(manga: dict) -> str:
    author = manga.get("autor") or "Desconocido"
    return f"{manga.get('titulo', '')}  {CLR_DIM}({author}){CLR_RESET}"


def adult_category_label(count: int) -> str:
    return f"{CLR_YELLOW}+18 NSFW →{CLR_RESET} {results_count(count)} solo para adultos"


def chapter_label(chapter: dict) -> str:
    num = chapter.get("numeroCapitulo", "?")
    title = chapter.get("titulo") or f"Capítulo {num}"
    pages = chapter.get("totalPaginas", "?")
    scan = (chapter.get("grupoScan") or {}).get("nombre", "")
    scan_suffix = f" [{scan}]" if scan else ""
    return f"Cap. {num:<4} │ {title:<25} │ {pages} págs{scan_suffix}"


def ask_search_query():
    """Search prompt. Returns the query, or None on Esc or an empty answer."""
    return ask_text("Buscar manga > ", hint=SEARCH_TAGS_HINT)


def choose(options: list, prompt: str):
    """Shows (value, label) options in fzf, or as a numbered list without fzf. Returns the value, or None on Esc."""
    if has_fzf():
        return choose_with_fzf(options, prompt)
    return choose_from_numbered_list(options, prompt)


def choose_with_fzf(options: list, prompt: str):
    # Each line carries its option index before a tab; fzf shows only the label (--with-nth=2..).
    lines = [f"{index}\t{label}" for index, (_, label) in enumerate(options)]
    selected = run_fzf(lines, prompt=prompt)
    if selected is None:
        return None
    index = int(selected.split("\t")[0])
    return options[index][0]


def choose_from_numbered_list(options: list, prompt: str):
    print()
    for number, (_, label) in enumerate(options, 1):
        print(f" [{CLR_CYAN}{number}{CLR_RESET}] {label}")
    number = prompt_number(f"\n{prompt}[1-{len(options)}] (Enter o 'q' para regresar): ", 1, len(options))
    return options[number - 1][0] if number else None


def ask_text(prompt: str, default: str = "", hint: str = ""):
    """Free-text prompt, optionally prefilled and with a hint line. Returns the answer, or None on Esc or an empty answer."""
    if has_fzf():
        return ask_text_with_fzf(prompt, default, hint)
    if hint:
        print(f"{CLR_DIM}{hint}{CLR_RESET}")
    shown_default = f"[{default}] " if default else ""
    return read_line(f"{CLR_BOLD}{CLR_GREEN}{prompt}{CLR_RESET}{shown_default}") or default or None


# --- API Client ---

def fetch_search_results(query: str, genres: Sequence[str] = ()) -> list:
    """Searches series by title. Genres, when given, must all match: the API reads `genero=A,B` as an AND."""
    params = {"q": query}
    if genres:
        params["genero"] = ",".join(genres)
    data = make_api_request("/series-locales?" + urllib.parse.urlencode(params, quote_via=urllib.parse.quote))
    return data if isinstance(data, list) else []


def try_fetch_search_results(query: str, genres: Sequence[str] = ()) -> Optional[list]:
    """fetch_search_results, or None when the request fails (HTTP 429, no network)."""
    try:
        return fetch_search_results(query, genres)
    except OSError:  # urllib's URLError and HTTPError are OSError subclasses.
        return None


@functools.lru_cache(maxsize=1)
def fetch_genres() -> list:
    """The site's genre catalog (`nombre`, `total`), fetched once per run."""
    data = make_api_request("/series-locales/generos")
    return data if isinstance(data, list) else []


def fetch_chapters(series_public_id: str) -> list:
    """Fetches the series chapters in reading order."""
    data = make_api_request(f"/series-locales/{series_public_id}/capitulos")
    if not isinstance(data, list):
        return []
    return sorted(data, key=reading_order)


def reading_order(chapter: dict) -> tuple:
    """Sort key: chapter number first, then upload order (`orden`) for chapters sharing a number."""
    return (chapter_number(chapter), chapter.get("orden") or 0)


def chapter_number(chapter: dict) -> float:
    """`numeroCapitulo` as a number; chapters without a usable one sort last."""
    try:
        return float(chapter.get("numeroCapitulo"))
    except (TypeError, ValueError):
        return math.inf


def fetch_chapter_pages(chapter_public_id: str) -> list:
    """Fetches list of page image URLs."""
    data = make_api_request(f"/series-locales/capitulo/{chapter_public_id}/paginas")
    if isinstance(data, dict):
        return data.get("paginas", [])
    return []


def make_api_request(endpoint: str):
    """Executes GET request against the API."""
    url = f"{API_BASE}{endpoint}"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    with urllib.request.urlopen(req, context=ctx) as res:
        return json.loads(res.read().decode("utf-8"))


def download_binary_file(url: str, dest_path: Path):
    """Downloads binary file."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    with urllib.request.urlopen(req, context=ctx) as res, open(dest_path, "wb") as f:
        shutil.copyfileobj(res, f)


# --- System & Platform Helpers ---

def open_file_in_system_viewer(file_path: Path):
    """
    Opens file in system viewer.
    - macOS: Preview.app (open)
    - Linux / Arch Linux: Checks $MANGA_VIEWER, $PDFVIEWER, xdg-open, zathura, mupdf, evince, okular.
    """
    if sys.platform == "darwin":
        subprocess.Popen(["open", str(file_path)])
        return

    # Linux (Arch Linux, etc.)
    custom_viewer = os.environ.get("MANGA_VIEWER") or os.environ.get("PDFVIEWER")
    candidates = [custom_viewer, "zathura", "mupdf", "xdg-open", "evince", "okular"]

    for viewer in candidates:
        if viewer and shutil.which(viewer):
            subprocess.Popen([viewer, str(file_path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return

    print_warn(f"No se detectó un visor PDF gráfico. Puedes abrir el archivo manualmente en: {file_path}")


def render_image_timg(img_path: Path):
    """Renders image in terminal using timg."""
    timg = shutil.which("timg") or "/opt/homebrew/bin/timg"
    if os.path.exists(timg):
        subprocess.run([timg, "-pq", str(img_path)])


def has_fzf() -> bool:
    """Checks for fzf binary."""
    return bool(shutil.which("fzf") or os.path.exists("/opt/homebrew/bin/fzf"))


def run_fzf(lines: list, prompt: str):
    """fzf list. Returns the selected line, or None on Esc; Ctrl-C raises KeyboardInterrupt."""
    command = fzf_command(prompt) + ["--height=45%", "--tabstop=4", "--delimiter=\t", "--with-nth=2.."]
    result = subprocess.run(command, input="\n".join(lines), stdout=subprocess.PIPE, text=True)
    return parse_fzf_choice(result.returncode, result.stdout)


def ask_text_with_fzf(prompt: str, default: str, hint: str):
    """fzf with an empty list used as a text field, so Esc and Ctrl-C behave as in the lists."""
    command = fzf_command(prompt, hint) + ["--print-query", "--info=hidden", "--height=~10", f"--query={default}"]
    result = subprocess.run(command, input="", stdout=subprocess.PIPE, text=True)
    return parse_fzf_query(result.returncode, result.stdout)


def fzf_command(prompt: str, hint: str = "") -> list:
    fzf_bin = shutil.which("fzf") or "/opt/homebrew/bin/fzf"
    header = f"{FZF_KEYS_HINT}\n{hint}" if hint else FZF_KEYS_HINT
    return [
        fzf_bin,
        f"--prompt={prompt}",
        f"--header={header}",
        f"--expect={FZF_QUIT_KEY}",
        "--reverse",
        "--ansi",
    ]


def parse_fzf_choice(returncode: int, output: str):
    """Reads `--expect` output: the pressed key on the first line, the selected line on the second."""
    if returncode == FZF_ESC_STATUS:
        return None
    key, _, selected = output.partition("\n")
    stop_on_quit_key(key)
    return selected.rstrip("\n") or None


def parse_fzf_query(returncode: int, output: str):
    """Reads `--print-query --expect` output: the query on the first line, the pressed key on the second."""
    if returncode == FZF_ESC_STATUS:
        return None
    query, _, rest = output.partition("\n")
    stop_on_quit_key(rest.partition("\n")[0])
    return query.strip() or None


def stop_on_quit_key(key: str):
    if key == FZF_QUIT_KEY:
        raise KeyboardInterrupt


def clear_screen():
    """Clears terminal screen."""
    os.system("clear" if os.name != "nt" else "cls")


def chapter_file_name(manga_title: str, chapter: dict, extension: str) -> str:
    return f"{sanitize_filename(manga_title)} - Cap {chapter.get('numeroCapitulo', '?')}.{extension}"


def sanitize_filename(name: str) -> str:
    """Sanitizes filename strings."""
    return re.sub(r'[\\/*?:"<>|]', "", name).strip()


# --- History Management ---

def load_history() -> dict:
    """Loads history from config."""
    if HISTORY_FILE.exists():
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_history(manga: dict, chapter: dict):
    """Saves history to config."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    history = {
        "last_manga": {
            "publicId": manga.get("publicId"),
            "titulo": manga.get("titulo"),
            "autor": manga.get("autor")
        },
        "last_chapter_id": chapter.get("publicId"),
        "last_chapter_num": chapter.get("numeroCapitulo")
    }
    try:
        with open(HISTORY_FILE, "w", encoding="utf-8") as f:
            json.dump(history, f, indent=2, ensure_ascii=False)
    except Exception:
        pass


# --- CLI Output & Arguments ---

def parse_arguments():
    """Parses command line arguments."""
    import argparse
    parser = argparse.ArgumentParser(
        prog="shade-cli",
        description="Lee manga de shademanga.com desde tu terminal: busca con fzf y abre cada capítulo como PDF.",
        # Raw formatting keeps the paths below on one line; the default formatter wraps at hyphens.
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "teclas:\n"
            "  Esc regresa a la pantalla anterior · Ctrl-C sale\n\n"
            "etiquetas (en la búsqueda):\n"
            "  -nsfw                  solo títulos +18\n"
            "  -<género>              filtra por género: naruto -accion, -boys-love (ver --generos)\n\n"
            "archivos:\n"
            "  PDF en caché           ~/.cache/shade-cli/\n"
            "  PDF guardados y .cbz   $SHADE_DOWNLOAD_DIR/<manga> o ~/Downloads/shade-cli/<manga>\n"
            "  historial              ~/.config/shade-cli/history.json"
        )
    )
    parser.add_argument("query", nargs="*", help="Nombre del manga a buscar")
    parser.add_argument("-c", "--continue", dest="continue_reading", action="store_true", help="Abre el último capítulo que leíste")
    parser.add_argument("-d", "--download", action="store_true", help="Descarga capítulos como .cbz en la carpeta de descargas")
    parser.add_argument("-t", "--terminal", action="store_true", help="Lee en la terminal con timg en lugar del visor de PDF")
    parser.add_argument("--generos", dest="genres", action="store_true", help="Muestra los géneros que puedes usar como etiqueta")
    parser.add_argument("-v", "--version", action="store_true", help="Muestra la versión")
    return parser.parse_args()


def print_banner():
    """Prints ASCII banner."""
    banner = f"""{CLR_CYAN}{CLR_BOLD}
   _____ __               __        ________    ____
  / ___// /_  ____ _____/ /__     / ____/ /   /  _/
  \\__ \\/ __ \\/ __ `/ __  / _ \\   / /   / /    / /  
 ___/ / / / / /_/ / /_/ /  __/  / /___/ /____/ /   
/____/_/ /_/\\__,_/\\__,_/\\___/   \\____/_____/___/   
{CLR_DIM}    Manga desde tu terminal · v{VERSION}{CLR_RESET}
"""
    print(banner)


def prompt_number(message: str, min_val: int, max_val: int):
    """Asks for a number in range. Returns None on an empty answer or 'q'; re-asks on anything else."""
    while True:
        answer = read_line(message).lower()
        if answer in ("", "q"):
            return None
        if answer.isdigit() and min_val <= int(answer) <= max_val:
            return int(answer)
        print_warn(f"Introduce un número entre {min_val} y {max_val}.")


def read_line(message: str) -> str:
    """input() that treats Ctrl-D (EOF) as an empty answer; Ctrl-C still quits."""
    try:
        return input(message).strip()
    except EOFError:
        return ""


def exit_app():
    print("Saliendo...")
    sys.exit(0)


def print_info(msg: str):
    print(f"{CLR_BLUE}:: {CLR_RESET}{msg}")


def print_success(msg: str):
    print(f"{CLR_GREEN}✔ {CLR_RESET}{msg}")


def print_warn(msg: str):
    print(f"{CLR_YELLOW}▲ {CLR_RESET}{msg}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        exit_app()
